<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="duke.gui.MainWindow"
            stylesheets="@../css/main.css"
            prefHeight="400.0"
            prefWidth="600.0">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <AnchorPane.topAnchor>10.0</AnchorPane.topAnchor>
            <AnchorPane.leftAnchor>10.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>10.0</AnchorPane.rightAnchor>
            <AnchorPane.bottomAnchor>50.0</AnchorPane.bottomAnchor>
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="30.0">
            <AnchorPane.leftAnchor>10.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>100.0</AnchorPane.rightAnchor>
            <AnchorPane.bottomAnchor>10.0</AnchorPane.bottomAnchor>
        </TextField>
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="30.0"
                prefWidth="80.0"
                text="Send">
            <AnchorPane.rightAnchor>10.0</AnchorPane.rightAnchor>
            <AnchorPane.bottomAnchor>10.0</AnchorPane.bottomAnchor>
        </Button>
    </children>
</AnchorPane>
