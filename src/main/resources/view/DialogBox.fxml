<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         alignment="TOP_RIGHT"
         spacing="10.0"
         stylesheets="@../css/dialog-box.css"
         styleClass="dialog-box">
    <children>
        <Label fx:id="dialog" wrapText="true" styleClass="dialog-label" />
        <ImageView fx:id="displayPicture" id="displayPicture"
                   fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
    </children>
</fx:root>
